<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gravity Notes"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_notes_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 Pinned Notes"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Quick add note button -->
        <ImageButton
            android:id="@+id/btn_add_note"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_add"
            android:contentDescription="New Note"
            android:tint="#FFFFFF" />

        <!-- Quick add checklist button -->
        <ImageButton
            android:id="@+id/btn_add_checklist"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_agenda"
            android:contentDescription="New Checklist"
            android:tint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
