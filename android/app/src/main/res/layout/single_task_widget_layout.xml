<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_single_task_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_task_blue_bg"
    android:paddingTop="6dp">

    <!-- Top Blue Header Section: Date (Left) & Time (Right) -->
    <LinearLayout
        android:id="@+id/widget_task_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/widget_task_date_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tue, 1 June 2026"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_task_time_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02:00 AM"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- White Task Body Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_white_card_body"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Active Task Content -->
        <LinearLayout
            android:id="@+id/widget_task_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 1. Task Title at the Top (Primary Focal Point) -->
            <TextView
                android:id="@+id/widget_task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Things to do today"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold"
                android:lineSpacingExtra="1dp"
                android:singleLine="false"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- 2. Badges Row: Priority & Recurrence (Secondary Context) -->
            <LinearLayout
                android:id="@+id/widget_task_badges_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <!-- Priority Badge -->
                <LinearLayout
                    android:id="@+id/widget_task_priority_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:background="@drawable/widget_task_priority_high_bg">

                    <ImageView
                        android:id="@+id/widget_task_priority_icon"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_task_flag_red" />

                    <TextView
                        android:id="@+id/widget_task_priority_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:text="High"
                        android:textColor="#FF3B30"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Recurrence Badge -->
                <LinearLayout
                    android:id="@+id/widget_task_repeat_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginLeft="6dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:background="@drawable/widget_task_repeat_bg">

                    <TextView
                        android:id="@+id/widget_task_repeat_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Everyday"
                        android:textColor="#333333"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Flexible Space pushing Status Pill to the bottom -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 3. Centered Status Section (Pending vs Completed) -->
            <LinearLayout
                android:id="@+id/widget_task_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_task_status_bg"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp">

                <!-- Text on the Left -->
                <TextView
                    android:id="@+id/widget_task_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending"
                    android:textColor="#222222"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Icon on the Right -->
                <ImageView
                    android:id="@+id/widget_task_status_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="6dp"
                    android:src="@drawable/ic_task_clock_pending" />
            </LinearLayout>

        </LinearLayout>

        <!-- Fallback / Unconfigured State -->
        <LinearLayout
            android:id="@+id/widget_task_fallback_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_task_fallback_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Notes"
                android:textColor="#1E1E1E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_task_fallback_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tap to choose a task"
                android:textColor="#757575"
                android:textSize="9.5sp" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
