<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_multi_task_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top">

    <!-- ==================== TASK CARD 1 ==================== -->
    <LinearLayout
        android:id="@+id/multi_task_card_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_task_blue_bg"
        android:paddingTop="5dp"
        android:visibility="gone">

        <!-- Top Blue Header: Date (Left) & Time (Right) -->
        <LinearLayout
            android:id="@+id/multi_task_1_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/multi_task_1_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tue, 1 June 2026"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/multi_task_1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02:00 AM"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- White Card Body -->
        <LinearLayout
            android:id="@+id/multi_task_1_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_white_card_body"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Badges Column -->
            <LinearLayout
                android:id="@+id/multi_task_1_badges_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:visibility="gone">

                <!-- Priority Badge -->
                <LinearLayout
                    android:id="@+id/multi_task_1_priority_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/widget_task_priority_high_bg">

                    <ImageView
                        android:id="@+id/multi_task_1_priority_icon"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_task_flag_red" />

                    <TextView
                        android:id="@+id/multi_task_1_priority_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:text="High"
                        android:textColor="#FF3B30"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Recurrence Badge -->
                <LinearLayout
                    android:id="@+id/multi_task_1_repeat_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/widget_task_repeat_bg">

                    <TextView
                        android:id="@+id/multi_task_1_repeat_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily"
                        android:textColor="#555555"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Task Title -->
            <TextView
                android:id="@+id/multi_task_1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_gravity="center_vertical"
                android:text="Task Title"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold"
                android:lineSpacingExtra="1dp"
                android:singleLine="false"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Status Pill -->
            <LinearLayout
                android:id="@+id/multi_task_1_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:background="@drawable/widget_task_status_bg"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/multi_task_1_status_icon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_task_clock_pending" />

                <TextView
                    android:id="@+id/multi_task_1_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:text="Pending"
                    android:textColor="#555555"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

