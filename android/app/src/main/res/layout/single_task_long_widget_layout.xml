<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_single_task_long_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_task_blue_bg"
    android:paddingTop="6dp">

    <!-- Top Blue Header Section: Date (Left) & Time (Right) -->
    <LinearLayout
        android:id="@+id/widget_task_long_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/widget_task_long_date_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tue, 1 June 2026"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_task_long_time_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02:00 AM"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- White Task Body Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_white_card_body"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Active Task Content (Horizontal Flow: Left Column [Title + Badges], Right Column [Status Pill]) -->
        <LinearLayout
            android:id="@+id/widget_task_long_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left Column: Title (Top) and Badges Row (Bottom) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- 1. Task Title -->
                <TextView
                    android:id="@+id/widget_task_long_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Shopping with Friends"
                    android:textColor="#222222"
                    android:textSize="16.5sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="1dp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- 2. Badges Row: Priority & Recurrence -->
                <LinearLayout
                    android:id="@+id/widget_task_long_badges_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <!-- Priority Badge -->
                    <LinearLayout
                        android:id="@+id/widget_task_long_priority_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:background="@drawable/widget_task_priority_high_bg">

                        <ImageView
                            android:id="@+id/widget_task_long_priority_icon"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/ic_task_flag_red" />

                        <TextView
                            android:id="@+id/widget_task_long_priority_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="4dp"
                            android:text="High"
                            android:textColor="#FF3B30"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Recurrence Badge -->
                    <LinearLayout
                        android:id="@+id/widget_task_long_repeat_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginLeft="6dp"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:background="@drawable/widget_task_repeat_bg">

                        <TextView
                            android:id="@+id/widget_task_long_repeat_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Everyday"
                            android:textColor="#333333"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Right Column: Status Pill (Pending vs Completed) -->
            <LinearLayout
                android:id="@+id/widget_task_long_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_task_status_bg"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp">

                <!-- Text on the Left -->
                <TextView
                    android:id="@+id/widget_task_long_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completed"
                    android:textColor="#222222"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Icon on the Right -->
                <ImageView
                    android:id="@+id/widget_task_long_status_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="6dp"
                    android:src="@drawable/ic_task_check_completed" />
            </LinearLayout>

        </LinearLayout>

        <!-- Fallback / Unconfigured State -->
        <LinearLayout
            android:id="@+id/widget_task_long_fallback_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_task_long_fallback_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Notes"
                android:textColor="#1E1E1E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_task_long_fallback_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tap to choose a task"
                android:textColor="#757575"
                android:textSize="9.5sp" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
