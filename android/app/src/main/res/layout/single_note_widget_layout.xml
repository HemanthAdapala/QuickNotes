<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_single_note_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_yellow_card_bg"
    android:paddingTop="6dp">

    <!-- Top Yellow Header Section: Date (Left) & Time (Right) -->
    <LinearLayout
        android:id="@+id/widget_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/widget_date_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tue, 1 June 2026"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_time_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02:00 AM"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- White Note Body Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_white_card_body"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <!-- Active Note Content -->
        <LinearLayout
            android:id="@+id/widget_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Note Title -->
            <TextView
                android:id="@+id/widget_note_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Things to do today"
                android:textColor="#222222"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Semantic Content Lines Container -->
            <LinearLayout
                android:id="@+id/widget_lines_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginTop="5dp">

                <TextView
                    android:id="@+id/note_line_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.5dp"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:lineSpacingExtra="1.5dp"
                    android:singleLine="false"
                    android:maxLines="8"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/note_line_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.5dp"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:lineSpacingExtra="1.5dp"
                    android:singleLine="false"
                    android:maxLines="6"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/note_line_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.5dp"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:lineSpacingExtra="1.5dp"
                    android:singleLine="false"
                    android:maxLines="6"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/note_line_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.5dp"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:lineSpacingExtra="1.5dp"
                    android:singleLine="false"
                    android:maxLines="6"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/note_line_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.5dp"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:lineSpacingExtra="1.5dp"
                    android:singleLine="false"
                    android:maxLines="6"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/note_line_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.5dp"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:lineSpacingExtra="1.5dp"
                    android:singleLine="false"
                    android:maxLines="6"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/note_line_7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.5dp"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:lineSpacingExtra="1.5dp"
                    android:singleLine="false"
                    android:maxLines="6"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/note_line_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.5dp"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:lineSpacingExtra="1.5dp"
                    android:singleLine="false"
                    android:maxLines="6"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/note_line_9"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.5dp"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:lineSpacingExtra="1.5dp"
                    android:singleLine="false"
                    android:maxLines="6"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/note_line_10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.5dp"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:lineSpacingExtra="1.5dp"
                    android:singleLine="false"
                    android:maxLines="6"
                    android:ellipsize="end"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- Fallback / Unconfigured State -->
        <LinearLayout
            android:id="@+id/widget_fallback_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_fallback_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Notes"
                android:textColor="#1E1E1E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_fallback_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tap to choose a note"
                android:textColor="#757575"
                android:textSize="9.5sp" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
